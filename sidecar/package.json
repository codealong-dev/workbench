{
  "name": "workbench-sidecar",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/claude.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/claude.js --packages=external",
    "build:dist": "esbuild src/claude.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/claude.bundle.js --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.284"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
